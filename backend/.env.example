# Server
PORT=3001

# Optional: pre-seed config on first boot instead of using the Settings UI.
# All of these can also be set (and edited) from the frontend Settings page,
# which persists them to backend/data/config.json (gitignored).
# Jira and Bitbucket use separate API tokens.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=https://yourdomain.atlassian.net
JIRA_STORY_POINTS_FIELD=customfield_10016
BITBUCKET_WORKSPACE=
BITBUCKET_API_TOKEN=

# AI agent used by the "AI Review" tab. Provider is one of: claude, codex, cursor.
# AI_MODEL is optional — leave blank to use the provider's default.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Claude only: set to "true" to authenticate via an `ant auth login` OAuth profile on this
# machine (a Claude Pro/Max seat) instead of AI_API_KEY, avoiding separate API billing.
# Codex and Cursor have no such env toggle — Codex always needs its own OpenAI API key,
# and Cursor keys already draw from the same plan as your Cursor subscription.
AI_USE_CLAUDE_SUBSCRIPTION=
